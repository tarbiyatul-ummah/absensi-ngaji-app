rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserData(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function validName(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validDate(value) {
      return value is string
        && value.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    function validAttendance(data, attendanceId) {
      return data.keys().hasOnly([
          "id",
          "date",
          "santriId",
          "jilidId",
          "guruId",
          "isPresent",
          "status"
        ])
        && data.keys().hasAll([
          "id",
          "date",
          "santriId",
          "jilidId",
          "guruId",
          "isPresent"
        ])
        && data.id == attendanceId
        && validDate(data.date)
        && data.santriId is string
        && data.jilidId is string
        && data.guruId is string
        && data.isPresent is bool
        && (
          !data.keys().hasAny(["status"])
          || data.status in ["present", "permission", "absent"]
        );
    }

    function validSantri(data) {
      return data.keys().hasOnly([
          "nama",
          "jilidId",
          "guruId",
          "tipeId",
          "tanggalLahir",
          "isActive",
          "createdAt"
        ])
        && data.keys().hasAll([
          "nama",
          "jilidId",
          "guruId",
          "isActive"
        ])
        && validName(data.nama, 120)
        && data.jilidId is string
        && data.guruId is string
        && (
          !data.keys().hasAny(["tipeId"])
          || data.tipeId is string
        )
        && (
          !data.keys().hasAny(["tanggalLahir"])
          || validDate(data.tanggalLahir)
        )
        && data.isActive is bool
        && (
          !data.keys().hasAny(["createdAt"])
          || data.createdAt is number
        );
    }

    function validGuru(data) {
      return data.keys().hasOnly(["nama"])
        && data.keys().hasAll(["nama"])
        && validName(data.nama, 120);
    }

    function validJilid(data) {
      return data.keys().hasOnly(["nama", "urutan"])
        && data.keys().hasAll(["nama"])
        && validName(data.nama, 80)
        && (
          !data.keys().hasAny(["urutan"])
          || data.urutan is number
        );
    }

    function validSantriType(data) {
      return data.keys().hasOnly(["nama", "createdAt"])
        && data.keys().hasAll(["nama"])
        && validName(data.nama, 80)
        && (
          !data.keys().hasAny(["createdAt"])
          || data.createdAt is number
        );
    }

    function validMonth(value) {
      return value is string
        && value.matches("^\\d{4}-\\d{2}$");
    }

    function validSppPayment(data, paymentId) {
      return data.keys().hasOnly([
          "id",
          "santriId",
          "academicYearStart",
          "month",
          "isPaid",
          "paidAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "id",
          "santriId",
          "academicYearStart",
          "month",
          "isPaid",
          "updatedAt"
        ])
        && data.id == paymentId
        && data.santriId is string
        && data.academicYearStart is number
        && validMonth(data.month)
        && data.isPaid is bool
        && data.updatedAt is number
        && (
          !data.keys().hasAny(["paidAt"])
          || data.paidAt == null
          || data.paidAt is number
        );
    }

    function validStringList(values, maxLength) {
      return values is list
        && values.size() > 0
        && values.size() <= maxLength;
    }

    function validSavingsAccount(data) {
      return data.keys().hasOnly([
          "name",
          "academicYearStart",
          "semester",
          "mode",
          "santriIds",
          "createdAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "name",
          "academicYearStart",
          "semester",
          "mode",
          "santriIds",
          "createdAt",
          "updatedAt"
        ])
        && validName(data.name, 120)
        && data.academicYearStart is number
        && data.semester in ["ganjil", "genap"]
        && data.mode == "monthly"
        && validStringList(data.santriIds, 1000)
        && data.createdAt is number
        && data.updatedAt is number;
    }

    function validSavingsPayment(data, paymentId) {
      return data.keys().hasOnly([
          "id",
          "savingsAccountId",
          "santriId",
          "academicYearStart",
          "semester",
          "month",
          "isPaid",
          "paidAt",
          "updatedAt"
        ])
        && data.keys().hasAll([
          "id",
          "savingsAccountId",
          "santriId",
          "academicYearStart",
          "semester",
          "month",
          "isPaid",
          "updatedAt"
        ])
        && data.id == paymentId
        && data.savingsAccountId is string
        && data.santriId is string
        && data.academicYearStart is number
        && data.semester in ["ganjil", "genap"]
        && validMonth(data.month)
        && data.isPaid is bool
        && data.updatedAt is number
        && (
          !data.keys().hasAny(["paidAt"])
          || data.paidAt == null
          || data.paidAt is number
        );
    }

    match /users/{userId}/attendances/{attendanceId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId)
        && validAttendance(request.resource.data, attendanceId);
      allow delete: if false;
    }

    match /users/{userId}/santri/{santriId} {
      allow read: if ownsUserData(userId);
      allow create: if ownsUserData(userId)
        && validSantri(request.resource.data)
        && request.resource.data.keys().hasAll(["createdAt"]);
      allow update: if ownsUserData(userId)
        && validSantri(request.resource.data);
      allow delete: if ownsUserData(userId);
    }

    match /users/{userId}/guru/{guruId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId)
        && validGuru(request.resource.data);
      allow delete: if ownsUserData(userId);
    }

    match /users/{userId}/jilid/{jilidId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId)
        && validJilid(request.resource.data);
      allow delete: if ownsUserData(userId);
    }

    match /users/{userId}/santriTypes/{typeId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId)
        && validSantriType(request.resource.data);
      allow delete: if ownsUserData(userId);
    }

    match /users/{userId}/sppPayments/{paymentId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId)
        && validSppPayment(request.resource.data, paymentId);
      allow delete: if false;
    }

    match /users/{userId}/savingsAccounts/{accountId} {
      allow read: if ownsUserData(userId);
      allow create: if ownsUserData(userId)
        && validSavingsAccount(request.resource.data);
      allow update: if ownsUserData(userId)
        && validSavingsAccount(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if ownsUserData(userId);
    }

    match /users/{userId}/savingsPayments/{paymentId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId)
        && validSavingsPayment(request.resource.data, paymentId);
      allow delete: if ownsUserData(userId);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
